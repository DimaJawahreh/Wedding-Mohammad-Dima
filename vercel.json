{
  "rewrites": [
    { "source": "/1", "destination": "/index.html" },
    { "source": "/2", "destination": "/index.html" },
    { "source": "/3", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
